    }

    fundecl b2CollideCircles(circleA: cptr b2Circle, xfA: b2Transform, circleB: cptr b2Circle, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollideCapsuleAndCircle(capsuleA: cptr b2Capsule, xfA: b2Transform, circleB: cptr b2Circle, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollideSegmentAndCircle(segmentA: cptr b2Segment, xfA: b2Transform, circleB: cptr b2Circle, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollidePolygonAndCircle(polygonA: cptr b2Polygon, xfA: b2Transform, circleB: cptr b2Circle, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollideCapsules(capsuleA: cptr b2Capsule, xfA: b2Transform, capsuleB: cptr b2Capsule, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollideSegmentAndCapsule(segmentA: cptr b2Segment, xfA: b2Transform, capsuleB: cptr b2Capsule, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollidePolygonAndCapsule(polygonA: cptr b2Polygon, xfA: b2Transform, capsuleB: cptr b2Capsule, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollidePolygons(polygonA: cptr b2Polygon, xfA: b2Transform, polygonB: cptr b2Polygon, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollideSegmentAndPolygon(segmentA: cptr b2Segment, xfA: b2Transform, polygonB: cptr b2Polygon, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollideChainSegmentAndCircle(segmentA: cptr b2ChainSegment, xfA: b2Transform, circleB: cptr b2Circle, xfB: b2Transform) -> b2Manifold;
    fundecl b2CollideChainSegmentAndCapsule(segmentA: cptr b2ChainSegment, xfA: b2Transform, capsuleB: cptr b2Capsule, xfB: b2Transform, cache: cptr mut b2SimplexCache) -> b2Manifold;
    fundecl b2CollideChainSegmentAndPolygon(segmentA: cptr b2ChainSegment, xfA: b2Transform, polygonB: cptr b2Polygon, xfB: b2Transform, cache: cptr mut b2SimplexCache) -> b2Manifold;

    class b2DynamicTree {
        nodes: cptr mut u8;
        root: i32;
        nodeCount: i32;
        nodeCapacity: i32;
        freeList: i32;
        proxyCount: i32;
        leafIndices: cptr mut i32;
        leafBoxes: cptr mut b2AABB;
        leafCenters: cptr mut b2Vec2;
        binIndices: cptr mut i32;
        rebuildCapacity: i32;
    }

    class b2TreeStats {
        nodeVisits: i32;
        leafVisits: i32;
    }

    fundecl b2DynamicTree_Create() -> b2DynamicTree;
    fundecl b2DynamicTree_Destroy(tree: cptr mut b2DynamicTree) -> ();
    fundecl b2DynamicTree_CreateProxy(tree: cptr mut b2DynamicTree, aabb: b2AABB, categoryBits: u64, userData: u64) -> i32;
    fundecl b2DynamicTree_DestroyProxy(tree: cptr mut b2DynamicTree, proxyId: i32) -> ();
    fundecl b2DynamicTree_MoveProxy(tree: cptr mut b2DynamicTree, proxyId: i32, aabb: b2AABB) -> ();
    fundecl b2DynamicTree_EnlargeProxy(tree: cptr mut b2DynamicTree, proxyId: i32, aabb: b2AABB) -> ();
    fundecl b2DynamicTree_SetCategoryBits(tree: cptr mut b2DynamicTree, proxyId: i32, categoryBits: u64) -> ();
