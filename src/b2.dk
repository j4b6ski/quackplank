        upperBound: b2Vec2;
    }

    class b2Plane {
        normal: b2Vec2;
        offset: f32;
    }
}

const B2_PI: f32 = 3.14159274f32;

let b2Vec2_zero = b2Vec2(0.0, 0.0);
let b2Rot_identity = b2Rot(1.0, 0.0);
let b2Transform_identity = b2Transform(b2Vec2(0.0, 0.0), b2Rot(1.0, 0.0));
let b2Mat22_zero = b2Mat22(b2Vec2(0.0, 0.0), b2Vec2(0.0, 0.0));

