const B2_MAX_POLYGON_VERTICES: i32 = 8i32;

extern("C") {
    class b2RayCastInput {
        origin: b2Vec2;
        translation: b2Vec2;
        maxFraction: f32;
    }

    class b2ShapeProxy {
        points: b2Vec2[8];
        count: i32;
        radius: f32;
    }

    class b2ShapeCastInput {
        proxy: b2ShapeProxy;
        translation: b2Vec2;
        maxFraction: f32;
        canEncroach: bool;
    }

    class b2CastOutput {
        normal: b2Vec2;
        point: b2Vec2;
        fraction: f32;
        iterations: i32;
        hit: bool;
    }

    class b2MassData {
        mass: f32;
        center: b2Vec2;
        rotationalInertia: f32;
    }

    class b2Circle {
        center: b2Vec2;
        radius: f32;
    }

    class b2Capsule {
        center1: b2Vec2;
        center2: b2Vec2;
        radius: f32;
    }

    class b2Polygon {
        vertices: b2Vec2[8];
        normals: b2Vec2[8];
        centroid: b2Vec2;
        radius: f32;
        count: i32;
    }

    class b2Segment {
        point1: b2Vec2;
        point2: b2Vec2;
    }

    class b2ChainSegment {
        ghost1: b2Vec2;
        segment: b2Segment;
        ghost2: b2Vec2;
        chainId: i32;
    }

    fundecl b2IsValidRay(input: cptr b2RayCastInput) -> bool;
    fundecl b2MakePolygon(hull: cptr b2Hull, radius: f32) -> b2Polygon;
    fundecl b2MakeOffsetPolygon(hull: cptr b2Hull, position: b2Vec2, rotation: b2Rot) -> b2Polygon;
    fundecl b2MakeOffsetRoundedPolygon(hull: cptr b2Hull, position: b2Vec2, rotation: b2Rot, radius: f32) -> b2Polygon;
    fundecl b2MakeSquare(halfWidth: f32) -> b2Polygon;
    fundecl b2MakeBox(halfWidth: f32, halfHeight: f32) -> b2Polygon;
    fundecl b2MakeRoundedBox(halfWidth: f32, halfHeight: f32, radius: f32) -> b2Polygon;
    fundecl b2MakeOffsetBox(halfWidth: f32, halfHeight: f32, center: b2Vec2, rotation: b2Rot) -> b2Polygon;
    fundecl b2MakeOffsetRoundedBox(halfWidth: f32, halfHeight: f32, center: b2Vec2, rotation: b2Rot, radius: f32) -> b2Polygon;
    fundecl b2TransformPolygon(transform: b2Transform, polygon: cptr b2Polygon) -> b2Polygon;
    fundecl b2ComputeCircleMass(shape: cptr b2Circle, density: f32) -> b2MassData;
    fundecl b2ComputeCapsuleMass(shape: cptr b2Capsule, density: f32) -> b2MassData;
    fundecl b2ComputePolygonMass(shape: cptr b2Polygon, density: f32) -> b2MassData;
    fundecl b2ComputeCircleAABB(shape: cptr b2Circle, transform: b2Transform) -> b2AABB;
    fundecl b2ComputeCapsuleAABB(shape: cptr b2Capsule, transform: b2Transform) -> b2AABB;
    fundecl b2ComputePolygonAABB(shape: cptr b2Polygon, transform: b2Transform) -> b2AABB;
    fundecl b2ComputeSegmentAABB(shape: cptr b2Segment, transform: b2Transform) -> b2AABB;
    fundecl b2PointInCircle(point: b2Vec2, shape: cptr b2Circle) -> bool;
    fundecl b2PointInCapsule(point: b2Vec2, shape: cptr b2Capsule) -> bool;
    fundecl b2PointInPolygon(point: b2Vec2, shape: cptr b2Polygon) -> bool;
    fundecl b2RayCastCircle(input: cptr b2RayCastInput, shape: cptr b2Circle) -> b2CastOutput;
    fundecl b2RayCastCapsule(input: cptr b2RayCastInput, shape: cptr b2Capsule) -> b2CastOutput;
    fundecl b2RayCastSegment(input: cptr b2RayCastInput, shape: cptr b2Segment, oneSided: bool) -> b2CastOutput;
    fundecl b2RayCastPolygon(input: cptr b2RayCastInput, shape: cptr b2Polygon) -> b2CastOutput;
    fundecl b2ShapeCastCircle(input: cptr b2ShapeCastInput, shape: cptr b2Circle) -> b2CastOutput;
    fundecl b2ShapeCastCapsule(input: cptr b2ShapeCastInput, shape: cptr b2Capsule) -> b2CastOutput;
    fundecl b2ShapeCastSegment(input: cptr b2ShapeCastInput, shape: cptr b2Segment) -> b2CastOutput;
    fundecl b2ShapeCastPolygon(input: cptr b2ShapeCastInput, shape: cptr b2Polygon) -> b2CastOutput;

    class b2Hull {
        points: b2Vec2[8];
        count: i32;
    }

    fundecl b2ComputeHull(points: cptr b2Vec2, count: i32) -> b2Hull;
    fundecl b2ValidateHull(hull: cptr b2Hull) -> bool;

    class b2SegmentDistanceResult {
        closest1: b2Vec2;
        closest2: b2Vec2;
        fraction1: f32;
        fraction2: f32;
        distanceSquared: f32;
    }

    fundecl b2SegmentDistance(p1: b2Vec2, q1: b2Vec2, p2: b2Vec2, q2: b2Vec2) -> b2SegmentDistanceResult;

    class b2SimplexCache {
        count: u16;
        indexA: u8[3];
        indexB: u8[3];
    }
}

let b2_emptySimplexCache = b2SimplexCache(0u16, [0u8, 0u8, 0u8], [0u8, 0u8, 0u8]);

extern("C") {
    class b2DistanceInput {
        proxyA: b2ShapeProxy;
        proxyB: b2ShapeProxy;
        transformA: b2Transform;
        transformB: b2Transform;
        useRadii: bool;
    }

    class b2DistanceOutput {
        pointA: b2Vec2;
        pointB: b2Vec2;
        normal: b2Vec2;
        distance: f32;
        iterations: i32;
        simplexCount: i32;
    }

    class b2SimplexVertex {
        wA: b2Vec2;
        wB: b2Vec2;
        w: b2Vec2;
        a: f32;
        indexA: i32;
        indexB: i32;
    }

    class b2Simplex {
        v1: b2SimplexVertex;
        v2: b2SimplexVertex;
        v3: b2SimplexVertex;
        count: i32;
    }

    fundecl b2ShapeDistance(input: cptr b2DistanceInput, cache: cptr mut b2SimplexCache, simplexes: cptr mut b2Simplex, simplexCapacity: i32) -> b2DistanceOutput;

    class b2ShapeCastPairInput {
        proxyA: b2ShapeProxy;
        proxyB: b2ShapeProxy;
        transformA: b2Transform;
        transformB: b2Transform;
        translationB: b2Vec2;
        maxFraction: f32;
        canEncroach: bool;
    }

    fundecl b2ShapeCast(input: cptr b2ShapeCastPairInput) -> b2CastOutput;
    fundecl b2MakeProxy(points: cptr b2Vec2, count: i32, radius: f32) -> b2ShapeProxy;
    fundecl b2MakeOffsetProxy(points: cptr b2Vec2, count: i32, radius: f32, position: b2Vec2, rotation: b2Rot) -> b2ShapeProxy;

    class b2Sweep {
        localCenter: b2Vec2;
        c1: b2Vec2;
        c2: b2Vec2;
        q1: b2Rot;
        q2: b2Rot;
    }

    fundecl b2GetSweepTransform(sweep: cptr b2Sweep, time: f32) -> b2Transform;

    class b2TOIInput {
        proxyA: b2ShapeProxy;
        proxyB: b2ShapeProxy;
        sweepA: b2Sweep;
        sweepB: b2Sweep;
        maxFraction: f32;
    }
}

