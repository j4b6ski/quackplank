fun b2ComputeHull(points: ref List[b2Vec2]) -> b2Hull =
    b2ComputeHull(points.pointer as cptr b2Vec2, points.length() as i32);

fun b2MakeProxy(points: ref b2Vec2, count: i64, radius: f32) -> b2ShapeProxy =
    b2MakeProxy(points as cptr b2Vec2, count as i32, radius);

fun b2MakeProxy(points: ref List[b2Vec2], radius: f32) -> b2ShapeProxy =
    b2MakeProxy(points.pointer as cptr b2Vec2, points.length() as i32, radius);

fun b2MakeOffsetProxy(points: ref b2Vec2, count: i64, radius: f32, position: b2Vec2, rotation: b2Rot) -> b2ShapeProxy =
    b2MakeOffsetProxy(points as cptr b2Vec2, count as i32, radius, position, rotation);

fun b2MakeOffsetProxy(points: ref List[b2Vec2], radius: f32, position: b2Vec2, rotation: b2Rot) -> b2ShapeProxy =
    b2MakeOffsetProxy(points.pointer as cptr b2Vec2, points.length() as i32, radius, position, rotation);

fun b2Body_SetName(bodyId: b2BodyId, name: str | String) -> () = {
    let chars = match (&name) {
        case s: ref str = *s;
        case s: ref String = s.asSlice();
    };
    var buffer: char[32];
    let dst = &buffer[0] as cptr mut char;
    let count = math.min(chars.length(), buffer.length() - 1);

    copyChars(builtins.ptr_from_slice[char](chars), dst as manyptr mut char, count);
    b2Body_SetName(bodyId, dst as cptr char);
}

