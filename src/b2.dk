import std.math as math;

const b2AllocFcn = cptr u8;
const b2FreeFcn = cptr u8;
const b2AssertFcn = cptr u8;

extern("C") {
    fundecl b2SetAllocator(allocFcn: b2AllocFcn, freeFcn: b2FreeFcn) -> ();
    fundecl b2GetByteCount() -> i32;
    fundecl b2SetAssertFcn(assertFcn: b2AssertFcn) -> ();

    class b2Version {
        major: i32;
        minor: i32;
        revision: i32;
    }

    fundecl b2GetVersion() -> b2Version;
    fundecl b2GetTicks() -> u64;
    fundecl b2GetMilliseconds(ticks: u64) -> f32;
    fundecl b2GetMillisecondsAndReset(ticks: cptr mut u64) -> f32;
    fundecl b2Yield() -> ();
}

const B2_HASH_INIT: i32 = 5381i32;

extern("C") {
    fundecl b2Hash(hash: u32, data: cptr u8, count: i32) -> u32;

    class b2Vec2 {
        x: f32;
        y: f32;
    }

    class b2CosSin {
        cosine: f32;
        sine: f32;
    }

    class b2Rot {
        c: f32;
        s: f32;
    }

    class b2Transform {
        p: b2Vec2;
        q: b2Rot;
    }

    class b2Mat22 {
        cx: b2Vec2;
        cy: b2Vec2;
    }

    class b2AABB {
        lowerBound: b2Vec2;
        upperBound: b2Vec2;
    }

    class b2Plane {
        normal: b2Vec2;
        offset: f32;
    }
}

const B2_PI: f32 = 3.14159274f32;

let b2Vec2_zero = b2Vec2(0.0, 0.0);
let b2Rot_identity = b2Rot(1.0, 0.0);
let b2Transform_identity = b2Transform(b2Vec2(0.0, 0.0), b2Rot(1.0, 0.0));
let b2Mat22_zero = b2Mat22(b2Vec2(0.0, 0.0), b2Vec2(0.0, 0.0));

