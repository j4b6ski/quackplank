    fundecl IsAudioStreamPlaying(stream: AudioStream) -> bool;
    fundecl StopAudioStream(stream: AudioStream) -> ();
    fundecl SetAudioStreamVolume(stream: AudioStream, volume: f32) -> ();
    fundecl SetAudioStreamPitch(stream: AudioStream, pitch: f32) -> ();
    fundecl SetAudioStreamPan(stream: AudioStream, pan: f32) -> ();
    fundecl SetAudioStreamBufferSizeDefault(size: i32) -> ();
    fundecl SetAudioStreamCallback(stream: AudioStream, callback: AudioCallback) -> ();
    fundecl AttachAudioStreamProcessor(stream: AudioStream, processor: AudioCallback) -> ();
    fundecl DetachAudioStreamProcessor(stream: AudioStream, processor: AudioCallback) -> ();
    fundecl AttachAudioMixedProcessor(processor: AudioCallback) -> ();
    fundecl DetachAudioMixedProcessor(processor: AudioCallback) -> ();
}

