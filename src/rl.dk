private fun toC_(text: str) -> String = {
    var buffer = stringReserve(text.length() + 1);
    buffer.append(text);
    buffer.append('\0');
    return buffer;
}

private fun toC_(text: String) -> String = {
    var buffer = move text;
    buffer.append('\0');
    return buffer;
}

private fun toC_(text: Text) -> String = match (move text) {
    case s: str = toC_(s);
    case s: String = toC_(move s);
};

private fun shaderText_(stage: ShaderText) -> String = match (move stage) {
    case s: ?str = if s.isEmpty() then stringReserve(0) else toC_(s.value());
    case s: String = toC_(move s);
};

private fun fromC_(p: cptr char) -> String = {
    let length = TextLength(p) as i64;
    var result = stringReserve(length);
    result.append(builtins.slice_from_ptr_len[char](p as manyptr char, length));
    return result;
}
