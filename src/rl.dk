extern("C") {
    class Vector2 {
        x: f32;
        y: f32;
    }

    class Vector3 {
        x: f32;
        y: f32;
        z: f32;
    }

    class Vector4 {
        x: f32;
        y: f32;
        z: f32;
        w: f32;
    }
}

const Quaternion = Vector4;

extern("C") {
    class Matrix {
        m0: f32;
        m4: f32;
        m8: f32;
        m12: f32;
        m1: f32;
        m5: f32;
        m9: f32;
        m13: f32;
        m2: f32;
        m6: f32;
        m10: f32;
        m14: f32;
        m3: f32;
        m7: f32;
        m11: f32;
        m15: f32;
    }

    class Color {
        r: u8;
        g: u8;
        b: u8;
        a: u8;
    }

    class Rectangle {
        x: f32;
        y: f32;
        width: f32;
        height: f32;
    }

    class Image {
        data: cptr mut u8;
        width: i32;
        height: i32;
        mipmaps: i32;
        format: i32;
    }

    class Texture {
        id: u32;
        width: i32;
        height: i32;
        mipmaps: i32;
        format: i32;
    }
}

const Texture2D = Texture;
const TextureCubemap = Texture;

extern("C") {
    class RenderTexture {
        id: u32;
        texture: Texture;
        depth: Texture;
    }
}

const RenderTexture2D = RenderTexture;

extern("C") {
    class NPatchInfo {
        source: Rectangle;
        left: i32;
        top: i32;
        right: i32;
        bottom: i32;
        layout: i32;
    }

    class GlyphInfo {
        value: i32;
        offsetX: i32;
        offsetY: i32;
        advanceX: i32;
        image: Image;
    }

    class Font {
        baseSize: i32;
        glyphCount: i32;
        glyphPadding: i32;
        texture: Texture2D;
        recs: cptr mut Rectangle;
        glyphs: cptr mut GlyphInfo;
    }

    class Camera3D {
        position: Vector3;
        target: Vector3;
        up: Vector3;
        fovy: f32;
        projection: i32;
    }
}

const Camera = Camera3D;

extern("C") {
    class Camera2D {
        offset: Vector2;
        target: Vector2;
        rotation: f32;
        zoom: f32;
    }

    class Mesh {
        vertexCount: i32;
        triangleCount: i32;
        vertices: cptr mut f32;
        texcoords: cptr mut f32;
        texcoords2: cptr mut f32;
        normals: cptr mut f32;
        tangents: cptr mut f32;
        colors: cptr mut u8;
        indices: cptr mut u16;
        boneCount: i32;
        boneIndices: cptr mut u8;
        boneWeights: cptr mut f32;
        animVertices: cptr mut f32;
        animNormals: cptr mut f32;
        vaoId: u32;
        vboId: cptr mut u32;
    }

    class Shader {
        id: u32;
        locs: cptr mut i32;
    }

    class MaterialMap {
        texture: Texture2D;
        color: Color;
        value: f32;
    }

    class Material {
        shader: Shader;
        maps: cptr mut MaterialMap;
        params: f32[4];
    }

    class Transform {
        translation: Vector3;
        rotation: Quaternion;
        scale: Vector3;
    }
}

const ModelAnimPose = cptr mut Transform;

extern("C") {
    class BoneInfo {
        name: char[32];
        parent: i32;
    }

    class ModelSkeleton {
        boneCount: u32;
        bones: cptr mut BoneInfo;
        bindPose: ModelAnimPose;
    }

    class Model {
        transform: Matrix;
        meshCount: i32;
        materialCount: i32;
        meshes: cptr mut Mesh;
        materials: cptr mut Material;
        meshMaterial: cptr mut i32;
        skeleton: ModelSkeleton;
        currentPose: ModelAnimPose;
        boneMatrices: cptr mut Matrix;
    }

    class ModelAnimation {
        name: char[32];
        boneCount: u32;
        keyframeCount: i32;
        keyframePoses: cptr mut ModelAnimPose;
    }

    class Ray {
        position: Vector3;
        direction: Vector3;
    }

    class RayCollision {
        hit: bool;
        distance: f32;
        point: Vector3;
        normal: Vector3;
    }

    class BoundingBox {
        min: Vector3;
        max: Vector3;
    }

    class Wave {
        frameCount: u32;
        sampleRate: u32;
        sampleSize: u32;
        channels: u32;
        data: cptr mut u8;
    }

    class AudioStream {
        buffer: cptr mut u8;
        processor: cptr mut u8;
        sampleRate: u32;
        sampleSize: u32;
        channels: u32;
    }

    class Sound {
        stream: AudioStream;
        frameCount: u32;
    }

    class Music {
        stream: AudioStream;
        frameCount: u32;
        looping: bool;
        ctxType: i32;
        ctxData: cptr mut u8;
    }

    class VrDeviceInfo {
        hResolution: i32;
        vResolution: i32;
        hScreenSize: f32;
        vScreenSize: f32;
        eyeToScreenDistance: f32;
        lensSeparationDistance: f32;
        interpupillaryDistance: f32;
        lensDistortionValues: f32[4];
        chromaAbCorrection: f32[4];
    }

    class VrStereoConfig {
        projection: Matrix[2];
        viewOffset: Matrix[2];
        leftLensCenter: f32[2];
        rightLensCenter: f32[2];
        leftScreenCenter: f32[2];
        rightScreenCenter: f32[2];
        scale: f32[2];
        scaleIn: f32[2];
    }

    class FilePathList {
        count: u32;
        paths: cptr mut (cptr mut char);
    }

    class AutomationEvent {
        frame: u32;
        type_: u32;
        params: i32[4];
    }

    class AutomationEventList {
        capacity: u32;
        count: u32;
        events: cptr mut AutomationEvent;
    }
}

