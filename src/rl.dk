    let buffer = toC_(move fileName);
    return GetFileModTime(buffer.pointer as cptr char);
}

fun GetFileExtension(fileName: Text) -> ?String = {
    let path = toC_(move fileName);
    let ext = GetFileExtension(path.pointer as cptr char);
    if (ext as u64 == 0u64) return none;
    return fromC_(ext);
}

fun GetFileName(filePath: Text) -> String = {
    let path = toC_(move filePath);
    return fromC_(GetFileName(path.pointer as cptr char));
}

