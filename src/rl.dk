    SetClipboardText(buffer.pointer as cptr char);
}

fun LoadShader(vsFileName: ShaderText, fsFileName: ShaderText) -> Shader = {
    let vs = shaderText_(move vsFileName);
    let fs = shaderText_(move fsFileName);
    return LoadShader(vs.pointer as cptr char, fs.pointer as cptr char);
}

fun LoadShaderFromMemory(vsCode: ShaderText, fsCode: ShaderText) -> Shader = {
    let vs = shaderText_(move vsCode);
    let fs = shaderText_(move fsCode);
    return LoadShaderFromMemory(vs.pointer as cptr char, fs.pointer as cptr char);
}

fun GetShaderLocation(shader: Shader, uniformName: Text) -> i32 = {
    let buffer = toC_(move uniformName);
    return GetShaderLocation(shader, buffer.pointer as cptr char);
}

fun GetShaderLocationAttrib(shader: Shader, attribName: Text) -> i32 = {
    let buffer = toC_(move attribName);
    return GetShaderLocationAttrib(shader, buffer.pointer as cptr char);
}

