const Text = str | String;

const ShaderText = (?str) | String;

fun InitWindow(width: i32, height: i32, title: Text) -> () = {
    let buffer = toC_(move title);
    InitWindow(width, height, buffer.pointer as cptr char);
}

fun SetWindowTitle(title: Text) -> () = {
    let buffer = toC_(move title);
    SetWindowTitle(buffer.pointer as cptr char);
}

fun SetClipboardText(text: Text) -> () = {
