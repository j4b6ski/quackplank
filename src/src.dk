import rl;
import std.math as math;

fun check(ok: bool) = {
    if (not ok)
        panicking.panic();
}

fun main() = {
    rl.InitWindow(800, 600, "QuackPlank");
    check(rl.IsWindowReady());

    var camera = rl.Camera2D(
        offset=rl.Vector2(rl.GetRenderWidth() as f32 / 2.0,
                          rl.GetRenderHeight() as f32 / 2.0),
        target=rl.Vector2(0.0, 0.0),
        rotation=0.0,
        zoom=40.0,
    );

    while (not rl.WindowShouldClose()) {
        if (rl.IsMouseButtonDown(rl.MOUSE_BUTTON_RIGHT)) {
            let delta = rl.GetMouseDelta();
            let scaleX = rl.GetRenderWidth() as f32 / (rl.GetScreenWidth() as f32);
            let scaleY = rl.GetRenderHeight() as f32 / (rl.GetScreenHeight() as f32);
            camera.target.x -= delta.x * scaleX / camera.zoom;
            camera.target.y -= delta.y * scaleY / camera.zoom;
        }

        let wheel = rl.GetMouseWheelMove();
        if (wheel != 0.0) {
            let mouse = rl.GetMousePosition();
            camera.target = rl.GetScreenToWorld2D(mouse, camera);
            camera.offset = mouse;
            let zoom = camera.zoom * math.exp(wheel * 0.2f32);
            camera.zoom = math.min(320.0, math.max(10.0, zoom));
        }

        rl.BeginDrawing();
        rl.ClearBackground(rl.BLACK);
        rl.BeginMode2D(camera);
        let step = 0.25;
        let viewport = rl.Vector2(rl.GetRenderWidth() as f32,
                                  rl.GetRenderHeight() as f32);
        let lo = rl.GetScreenToWorld2D(rl.Vector2(0.0, 0.0), camera);
        let hi = rl.GetScreenToWorld2D(viewport, camera);

        var col = (lo.x / step) as i32;
        while (col <= (hi.x / step) as i32) {
            let x = (col as f32) * step;
            rl.DrawLineV(rl.Vector2(x, lo.y), rl.Vector2(x, hi.y), rl.DARKGRAY);
            col += 1;
        }

        var row = (lo.y / step) as i32;
        while (row <= (hi.y / step) as i32) {
            let y = (row as f32) * step;
            rl.DrawLineV(rl.Vector2(lo.x, y), rl.Vector2(hi.x, y), rl.DARKGRAY);
            row += 1;
        }
        rl.EndMode2D();
        rl.DrawText(f"{rl.GetFPS()}",
                    posX=4, posY=4, fontSize=20, color=rl.GREEN);
        rl.EndDrawing();
    }

    rl.CloseWindow();
    return 0;
}
