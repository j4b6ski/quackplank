import rl;
import rl.Vector2 as Vec2;
import std.math as math;
const gridStep = 0.25;

fun check(ok: bool) = {
    if (not ok)
        panicking.panic();
}

fun updateCamera(camera: ref mut rl.Camera2D) = {
    if (rl.IsMouseButtonDown(rl.MOUSE_BUTTON_RIGHT)) {
        let delta = rl.GetMouseDelta();
        let scaleX = rl.GetRenderWidth() as f32 / (rl.GetScreenWidth() as f32);
        let scaleY = rl.GetRenderHeight() as f32 / (rl.GetScreenHeight() as f32);
        camera.target.x -= delta.x * scaleX / camera.zoom;
        camera.target.y -= delta.y * scaleY / camera.zoom;
    }

    let wheel = rl.GetMouseWheelMove();
    if (wheel != 0.0) {
        let mouse = rl.GetMousePosition();
        camera.target = rl.GetScreenToWorld2D(mouse, camera);
        camera.offset = mouse;
        let zoom = camera.zoom * math.exp(wheel * 0.2f32);
        camera.zoom = math.min(320.0, math.max(10.0, zoom));
    }
}

fun drawGrid(camera: ref rl.Camera2D) = {
    let color = rl.Color(40u8, 40u8, 40u8, 255u8);
    let viewport = rl.Vector2(rl.GetRenderWidth() as f32,
                              rl.GetRenderHeight() as f32);
    let lo = rl.GetScreenToWorld2D(rl.Vector2(0.0, 0.0), camera);
    let hi = rl.GetScreenToWorld2D(viewport, camera);

    var col = (lo.x / gridStep) as i32;
    while (col <= (hi.x / gridStep) as i32) {
        let x = (col as f32) * gridStep;
        rl.DrawLineV(rl.Vector2(x, lo.y), rl.Vector2(x, hi.y), color);
        col += 1;
    }

    var row = (lo.y / gridStep) as i32;
    while (row <= (hi.y / gridStep) as i32) {
        let y = (row as f32) * gridStep;
        rl.DrawLineV(rl.Vector2(lo.x, y), rl.Vector2(hi.x, y), color);
        row += 1;
    }
}

class Level {
    terrain: List[List[Vec2]];
    road: List[Vec2];
    anchors: List[Vec2];
}

fun level1() -> Level = {
    var terrain: List[List[Vec2]];
    var road: List[Vec2];
    for (p in [Vec2(-3.0, 0.0), Vec2(-1.5, 0.0), Vec2(0.0, 0.0),
               Vec2(1.5, 0.0), Vec2(3.0, 0.0)]) {
        road.push(p);
    }

    var left: List[Vec2];
    for (p in [Vec2(-10.0, 0.0), Vec2(-10.0, -7.5), Vec2(-1.0, -7.5),
               Vec2(-1.75, -3.75), road.pointer[0]]) {
        left.push(p);
    }
    terrain.push(move left);

    var right: List[Vec2];
    for (p in [road.pointer[road.length() - 1], Vec2(1.75, -3.75), Vec2(1.0, -7.5),
               Vec2(10.0, -7.5), Vec2(10.0, 0.0)]) {
        right.push(p);
    }
    terrain.push(move right);
    var anchors: List[Vec2];
    anchors.push(road.pointer[0]);
    anchors.push(road.pointer[road.length() - 1]);
    anchors.push(Vec2(-1.75, -3.75));
    anchors.push(Vec2(1.75, -3.75));
    return Level(move terrain, move road, move anchors);
}

fun drawTerrain(terrain: ref List[List[Vec2]]) = {
    var i = 0;
    while (i < terrain.length()) {
        let bank = &terrain.pointer[i];
        let a = bank.pointer[0];
        var j = 1;
        while (j + 1 < bank.length()) {
            let b = bank.pointer[j];
            let c = bank.pointer[j + 1];
            rl.DrawTriangle(Vec2(a.x, -a.y), Vec2(b.x, -b.y), Vec2(c.x, -c.y),
                            rl.DARKGREEN);
            j += 1;
        }
        i += 1;
    }
}

fun drawRoad(road: ref List[Vec2]) = {
    var i = 1;
    while (i < road.length()) {
        let a = road.pointer[i - 1];
        let b = road.pointer[i];
        rl.DrawLineV(Vec2(a.x, -a.y), Vec2(b.x, -b.y), rl.WHITE);
        i += 1;
    }
}

fun drawJoints(points: ref List[Vec2], color: rl.Color) = {
    var i = 0;
    while (i < points.length()) {
        let p = points.pointer[i];
        rl.DrawCircleV(Vec2(p.x, -p.y), gridStep / 5.0, color);
        i += 1;
    }
}

fun drawCursor(connection: Vec2) = {
    let x = connection.x;
    let y = -connection.y;
    let gap = gridStep * 0.25;
    let arm = gridStep * 0.5;

    rl.DrawLineV(Vec2(x - arm, y), Vec2(x - gap, y), rl.RED);
    rl.DrawLineV(Vec2(x + gap, y), Vec2(x + arm, y), rl.RED);
    rl.DrawLineV(Vec2(x, y - arm), Vec2(x, y - gap), rl.RED);
    rl.DrawLineV(Vec2(x, y + gap), Vec2(x, y + arm), rl.RED);
}

fun drawFps() = {
    rl.DrawText(f"{rl.GetFPS()}", posX=4, posY=4, fontSize=12, color=rl.GREEN);
}

fun drawCoords(col: i32, row: i32) = {
    rl.DrawText(f"{col}, {row}", 4, rl.GetScreenHeight() - 16, 12, rl.WHITE);
}

fun main() = {
    rl.InitWindow(800, 600, "QuackPlank");
    check(rl.IsWindowReady());

    var camera = rl.Camera2D(
        offset=rl.Vector2(rl.GetRenderWidth() as f32 / 2.0,
                          rl.GetRenderHeight() as f32 / 2.0),
        target=rl.Vector2(0.0, 0.0),
        rotation=0.0,
        zoom=40.0,
    );

    let level = level1();
    while (not rl.WindowShouldClose()) {
        updateCamera(&camera);

        let mouse = rl.GetScreenToWorld2D(rl.GetMousePosition(), camera);
        let x = mouse.x / gridStep;
        let y = -mouse.y / gridStep;
        let col = (if x >= 0.0 then x + 0.5 else x - 0.5) as i32;
        let row = (if y >= 0.0 then y + 0.5 else y - 0.5) as i32;
        let connection = rl.Vector2((col as f32) * gridStep, (row as f32) * gridStep);

        rl.BeginDrawing();
        rl.ClearBackground(rl.BLACK);

        rl.BeginMode2D(camera);
        drawGrid(&camera);
        drawTerrain(&level.terrain);
        drawRoad(&level.road);
        drawJoints(&level.road, rl.GRAY);
        drawJoints(&level.anchors, rl.WHITE);
        drawCursor(connection);
        rl.EndMode2D();

        drawFps();
        drawCoords(col, row);
        rl.EndDrawing();
    }

    rl.CloseWindow();
    return 0;
}
