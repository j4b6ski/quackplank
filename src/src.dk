import b2;
import b2.b2Manifold;
import b2.b2ShapeId;
import rl;
import rl.Vector2 as Vec2;
import std.math as math;

class RoadAnchor {
    road: b2.b2ShapeId;
    bank: b2.b2ShapeId;
    point: b2.b2Vec2;
}

const RoadAnchors = List[RoadAnchor];

extern("C") fundecl registerPreSolve(world: b2.b2WorldId, context: cptr u8) -> ();

extern("C") fun preSolve(a: b2.b2ShapeId, b: b2.b2ShapeId,
                        manifold: cptr mut b2Manifold, context: cptr mut u8) -> bool = {
    let lists = context as manyptr RoadAnchors;
    let anchors = &lists[0];
    let manifolds = manifold as manyptr mut b2Manifold;
    let contact = &manifolds[0];
    const clearance = 0.05f32;
    var i = 0;
    while (i < anchors.length()) {
        let anchor = anchors.pointer[i];
        let matches = (b2.B2_ID_EQUALS(a, anchor.road) and b2.B2_ID_EQUALS(b, anchor.bank)) or
                      (b2.B2_ID_EQUALS(b, anchor.road) and b2.B2_ID_EQUALS(a, anchor.bank));
        if (matches) {
            var kept = 0;
            var j = 0;
            while (j < contact.pointCount) {
                let point = contact.points[j];
                if (b2.b2DistanceSquared(point.point, anchor.point) > clearance * clearance) {
                    contact.points[kept] = point;
                    kept += 1;
                }
                j += 1;
            }
            contact.pointCount = kept;
        }
        i += 1;
    }
    return contact.pointCount > 0;
}

class Joint {
    position: Vec2;
    fixed: bool;
}

class PlankDef {
    a: i64;
    b: i64;
    road: bool;
}

class Bridge {
    joints: List[Joint];
    planks: List[PlankDef];
}

class Level {
    terrain: List[List[Vec2]];
    road: List[Joint];
    anchors: List[Vec2];
    start: Vec2;
}

fun level1() -> Level = {
    var level: Level;
    level.start = Vec2(-4.5, 0.0);

    for (vertices in [
        [Vec2(-10.0, 0.0), Vec2(-10.0, -7.5), Vec2(-1.0, -7.5),
         Vec2(-1.75, -3.75), Vec2(-3.0, 0.0)],
        [Vec2(3.0, 0.0), Vec2(1.75, -3.75), Vec2(1.0, -7.5),
         Vec2(10.0, -7.5), Vec2(10.0, 0.0)]
    ]) {
        var bank: List[Vec2];
        for (vertex in vertices) bank.push(vertex);
        level.terrain.push(move bank);
    }

    for (joint in [
        Joint(Vec2(-3.0, 0.0), fixed=true),
        Joint(Vec2(-1.5, 0.0), fixed=false),
        Joint(Vec2(0.0, 0.0), fixed=false),
        Joint(Vec2(1.5, 0.0), fixed=false),
        Joint(Vec2(3.0, 0.0), fixed=true)
    ]) level.road.push(joint);
    for (anchor in [Vec2(-2.0, -3.0), Vec2(2.0, -3.0)])
        level.anchors.push(anchor);
    return level;
}

fun initialBridge(level: ref Level) -> Bridge = {
    var bridge: Bridge;
    var i = 0;
    while (i < level.road.length()) {
        bridge.joints.push(level.road.pointer[i]);
        if (i > 0) bridge.planks.push(PlankDef(i - 1, i, road=true));
        i += 1;
    }
    i = 0;
    while (i < level.anchors.length()) {
        bridge.joints.push(Joint(level.anchors.pointer[i], fixed=true));
        i += 1;
    }
    return bridge;
}

class Plank {
    body: b2.b2BodyId;
    halfLength: f32;
    load: f32;
    releasePin: i64;
}

class Attachment {
    plank: i64;
    body: b2.b2BodyId;
    anchor: b2.b2Vec2;
    hinge: b2.b2JointId;
    load: f32;
}

const terrainCategory = 2u64;
const plankThickness = 0.05f32;

fun createTerrain(world: b2.b2WorldId, terrain: ref List[List[Vec2]], banks: ref mut List[b2ShapeId]) -> b2.b2BodyId = {
    let def = b2.b2DefaultBodyDef();
    let ground = b2.b2CreateBody(world, &def);
    var shape = b2.b2DefaultShapeDef();
    shape.filter.categoryBits = terrainCategory;
    shape.material.friction = 1.0;
    var i = 0;
    while (i < terrain.length()) {
        let bank = &terrain.pointer[i];
        var vertices: List[b2.b2Vec2];
        var j = 0;
        while (j < bank.length()) {
            let p = bank.pointer[j];
            vertices.push(b2.b2Vec2(p.x, p.y));
            j += 1;
        }
        let hull = b2.b2ComputeHull(&vertices);
        let polygon = b2.b2MakePolygon(&hull, 0.0);
        banks.push(b2.b2CreatePolygonShape(ground, &shape, &polygon));
        i += 1;
    }
    return ground;
}

fun createPlankBody(world: b2.b2WorldId, a: Vec2, b: Vec2,
                    length: f32, road: bool) -> b2.b2BodyId = {
    var board = b2.b2DefaultBodyDef();
    board.type_ = b2.b2_dynamicBody;
    board.angularDamping = 64.0;
    board.position = b2.b2Vec2((a.x + b.x) / 2.0, (a.y + b.y) / 2.0);
    board.rotation = b2.b2Rot((b.x - a.x) / length, (b.y - a.y) / length);
    let body = b2.b2CreateBody(world, &board);
    var shape = b2.b2DefaultShapeDef();
    shape.material.friction = 1.0;
    shape.density = 10.0 / plankThickness;
    shape.filter.groupIndex = -1;
    if (not road) shape.filter.maskBits = terrainCategory;
    let polygon = b2.b2MakeBox(length / 2.0, plankThickness / 2.0);
    b2.b2CreatePolygonShape(body, &shape, &polygon);
    return body;
}

fun connectPin(world: b2.b2WorldId, ends: ref mut List[Attachment]) = {
    var i = 1;
    while (i < ends.length()) {
        let base = ends.pointer[0];
        let end = ends.pointer[i];
        var hinge = b2.b2DefaultRevoluteJointDef();
        hinge.bodyIdA = base.body;
        hinge.bodyIdB = end.body;
        hinge.localAnchorA = base.anchor;
        hinge.localAnchorB = end.anchor;
        hinge.collideConnected = true;
        ends.pointer[i].hinge = b2.b2CreateRevoluteJoint(world, &hinge);
        i += 1;
    }
}

fun createBridge(world: b2.b2WorldId, ground: b2.b2BodyId, bridge: ref Bridge,
                 pins: ref mut List[List[Attachment]], planks: ref mut List[Plank]) = {
    var i = 0;
    while (i < bridge.joints.length()) {
        let joint = bridge.joints.pointer[i];
        var ends: List[Attachment];
        if (joint.fixed) {
            let anchor = b2.b2Vec2(joint.position.x, joint.position.y);
            ends.push(Attachment(-1, ground, anchor, b2.b2_nullJointId, 0.0));
        }
        pins.push(move ends);
        i += 1;
    }
    i = 0;
    while (i < bridge.planks.length()) {
        let def = bridge.planks.pointer[i];
        let first = math.min(def.a, def.b);
        let second = math.max(def.a, def.b);
        let a = bridge.joints.pointer[first].position;
        let b = bridge.joints.pointer[second].position;
        let length = b2.b2Distance(b2.b2Vec2(a.x, a.y), b2.b2Vec2(b.x, b.y));
        let half = length / 2.0;
        let body = createPlankBody(world, a, b, length, def.road);
        planks.push(Plank(body, half, 0.0, -1));
        pins.pointer[first].push(Attachment(i, body, b2.b2Vec2(-half, 0.0), b2.b2_nullJointId, 0.0));
        pins.pointer[second].push(Attachment(i, body, b2.b2Vec2(half, 0.0), b2.b2_nullJointId, 0.0));
        i += 1;
    }
    i = 0;
    while (i < pins.length()) {
        connectPin(world, &pins.pointer[i]);
        i += 1;
    }
}

fun findRoadAnchors(bridge: ref Bridge, planks: ref List[Plank],
                    banks: ref List[b2ShapeId]) -> List[RoadAnchor] = {
    var anchors: List[RoadAnchor];
    var i = 0;
    while (i < bridge.planks.length()) {
        let plank = bridge.planks.pointer[i];
        if (plank.road) {
            for (end in [plank.a, plank.b]) {
                let joint = bridge.joints.pointer[end];
                if (joint.fixed) {
                    let point = b2.b2Vec2(joint.position.x, joint.position.y);
                    var road: b2ShapeId;
                    b2.b2Body_GetShapes(planks.pointer[i].body, &road as cptr mut b2ShapeId, 1);
                    var j = 0;
                    while (j < banks.length()) {
                        let bank = banks.pointer[j];
                        if (b2.b2Shape_TestPoint(bank, point)) {
                            anchors.push(RoadAnchor(road, bank, point));
                            b2.b2Shape_EnablePreSolveEvents(road, true);
                        }
                        j += 1;
                    }
                }
            }
        }
        i += 1;
    }
    return anchors;
}

fun duckHeight(mass: f32) -> f32 = mass / 100.0;

fun duckCapsule(mass: f32) -> b2.b2Capsule = {
    let radius = duckHeight(mass) / 4.0;
    return b2.b2Capsule(b2.b2Vec2(0.0, radius), b2.b2Vec2(0.0, 3.0 * radius), radius);
}

fun applyDuckMass(body: b2.b2BodyId, mass: f32) = {
    b2.b2Body_SetMassData(body, b2.b2MassData(mass, b2.b2Vec2(0.0, duckHeight(mass) / 2.0), 0.0));
}

fun createDuck(world: b2.b2WorldId, feet: Vec2, mass: f32) -> b2.b2ShapeId = {
    var def = b2.b2DefaultBodyDef();
    def.type_ = b2.b2_dynamicBody;
    def.position = b2.b2Vec2(feet.x, feet.y);
    def.fixedRotation = true;
    let body = b2.b2CreateBody(world, &def);
    let capsule = duckCapsule(mass);
    var shape = b2.b2DefaultShapeDef();
    shape.material.friction = 1.0;
    shape.material.tangentSpeed = 1.0;
    let foot = b2.b2CreateCapsuleShape(body, &shape, &capsule);
    applyDuckMass(body, mass);
    return foot;
}

fun updateDuckMass(mass: ref mut f32) -> bool = {
    let up = rl.IsKeyPressed(rl.KEY_UP);
    let down = rl.IsKeyPressed(rl.KEY_DOWN);
    if (up == down) return false;

    let step = if up then 5.0f32 else -5.0f32;
    let next = math.max(1.0f32, mass + step);
    if (next == mass) return false;
    mass = next;
    return true;
}

fun resizeDuck(shape: b2.b2ShapeId, mass: f32) = {
    let body = b2.b2Shape_GetBody(shape);
    let capsule = duckCapsule(mass);
    b2.b2Shape_SetCapsule(shape, &capsule);
    applyDuckMass(body, mass);
    b2.b2Body_SetAwake(body, true);
}

fun bodyPosition(body: b2.b2BodyId) -> Vec2 = {
    let p = b2.b2Body_GetPosition(body);
    return Vec2(p.x, p.y);
}

fun releaseEnd(world: b2.b2WorldId, ends: ref mut List[Attachment], plank: i64) = {
    var i = 0;
    while (ends.pointer[i].plank != plank) i += 1;
    let rebuild = i == 0;
    if (rebuild) {
        var j = 1;
        while (j < ends.length()) {
            b2.b2DestroyJoint(ends.pointer[j].hinge);
            j += 1;
        }
    } else {
        b2.b2DestroyJoint(ends.pointer[i].hinge);
    }
    let last = ends.pop();
    if (i < ends.length()) ends.pointer[i] = last;
    if (rebuild and ends.length() > 0) {
        ends.pointer[0].hinge = b2.b2_nullJointId;
        connectPin(world, ends);
    }
}

fun recordLoad(planks: ref mut List[Plank], end: ref mut Attachment, pin: i64, force: b2.b2Vec2) = {
    end.load += (b2.b2Length(force) - end.load) / 8.0;
    let plank = &planks.pointer[end.plank];
    if (end.load > plank.load) {
        plank.load = end.load;
        plank.releasePin = pin;
    }
}

fun breakOverloadedPlanks(world: b2.b2WorldId, pins: ref mut List[List[Attachment]],
                         planks: ref mut List[Plank]) = {
    const breakForce = 4500.0;
    var i = 0;
    while (i < pins.length()) {
        let ends = &pins.pointer[i];
        if (ends.length() > 1 and ends.pointer[0].plank >= 0) {
            var net = b2.b2Vec2_zero;
            var j = 1;
            while (j < ends.length()) {
                let end = ends.pointer[j];
                let force = b2.b2Joint_GetConstraintForce(end.hinge);
                recordLoad(planks, &ends.pointer[j], i, force);
                net = b2.b2Sub(net, force);
                j += 1;
            }
            recordLoad(planks, &ends.pointer[0], i, net);
        }
        i += 1;
    }
    i = 0;
    while (i < planks.length()) {
        if (planks.pointer[i].load > breakForce) {
            releaseEnd(world, &pins.pointer[planks.pointer[i].releasePin], i);
            b2.b2Body_SetAngularDamping(planks.pointer[i].body, 0.0);
        }
        planks.pointer[i].load = 0.0;
        i += 1;
    }
}

fun updateCamera(camera: ref mut rl.Camera2D, initialZoom: f32) = {
    let wheel = rl.GetMouseWheelMove();
    if (wheel != 0.0) {
        let mouse = rl.GetMousePosition();
        camera.target = rl.GetScreenToWorld2D(mouse, camera);
        camera.offset = mouse;
        camera.zoom *= math.exp(wheel / 5.0);
    }

    constrainCamera(camera, initialZoom);
}

fun constrainCamera(camera: ref mut rl.Camera2D, initialZoom: f32) = {
    let mapWidth = 20.0;
    let mapHeight = 15.0;
    let width = rl.GetScreenWidth() as f32;
    let height = rl.GetScreenHeight() as f32;
    let minZoom = math.max(initialZoom, math.max(width / mapWidth, height / mapHeight));
    const maxZoomFactor = 8.0;
    camera.zoom = math.max(minZoom, math.min(camera.zoom, initialZoom * maxZoomFactor));

    let minX = camera.offset.x / camera.zoom - mapWidth / 2.0;
    let maxX = mapWidth / 2.0 - (width - camera.offset.x) / camera.zoom;
    let minY = camera.offset.y / camera.zoom - mapHeight / 2.0;
    let maxY = mapHeight / 2.0 - (height - camera.offset.y) / camera.zoom;
    camera.target.x = math.min(maxX, math.max(minX, camera.target.x));
    camera.target.y = math.min(maxY, math.max(minY, camera.target.y));
}

class GridPoint {
    col: i32;
    row: i32;
}

const gridStep = 0.25;
const maxBeamCells = 7;
const maxBeamLength = (maxBeamCells as f32) * gridStep;

fun gridIndex(position: f32) -> i32 = {
    let index = position / gridStep;
    return (if index >= 0.0 then index + 0.5 else index - 0.5) as i32;
}

fun mousePosition(camera: ref rl.Camera2D) -> Vec2 = {
    let mouse = rl.GetScreenToWorld2D(rl.GetMousePosition(), camera);
    return Vec2(mouse.x, -mouse.y);
}

fun gridPosition(point: GridPoint) -> Vec2 =
    Vec2((point.col as f32) * gridStep, (point.row as f32) * gridStep);

fun crossesBank(a: Vec2, b: Vec2, bank: ref List[Vec2]) -> bool = {
    var enter = 0.0f32;
    var leave = 1.0f32;
    var i = 0;
    while (i < bank.length()) {
        let p = bank.pointer[i];
        let q = bank.pointer[(i + 1) % bank.length()];
        let dx = q.x - p.x;
        let dy = q.y - p.y;
        let start = dx * (a.y - p.y) - dy * (a.x - p.x);
        let end = dx * (b.y - p.y) - dy * (b.x - p.x);
        if (start <= 0.0 and end <= 0.0) return false;
        if (start <= 0.0) enter = math.max(enter, start / (start - end));
        if (end <= 0.0) leave = math.min(leave, start / (start - end));
        i += 1;
    }
    return enter < leave;
}

fun canPlaceBeam(bridge: ref Bridge, terrain: ref List[List[Vec2]], start: i64, b: Vec2) -> bool = {
    let a = bridge.joints.pointer[start].position;
    let dx = b.x - a.x;
    let dy = b.y - a.y;
    let lengthSquared = dx * dx + dy * dy;
    if (lengthSquared == 0.0 or lengthSquared > maxBeamLength * maxBeamLength) return false;
    var i = 0;
    while (i < terrain.length()) {
        if (crossesBank(a, b, &terrain.pointer[i])) return false;
        i += 1;
    }
    let end = jointAt(&bridge.joints, b);
    if (end < 0) return true;
    i = 0;
    while (i < bridge.planks.length()) {
        let plank = bridge.planks.pointer[i];
        if ((plank.a == start and plank.b == end) or
            (plank.a == end and plank.b == start)) return false;
        i += 1;
    }
    return true;
}

fun onBankEdge(point: Vec2, terrain: ref List[List[Vec2]]) -> bool = {
    var i = 0;
    while (i < terrain.length()) {
        let bank = &terrain.pointer[i];
        var j = 0;
        while (j < bank.length()) {
            let a = bank.pointer[j];
            let b = bank.pointer[(j + 1) % bank.length()];
            if ((point.x - a.x) * (b.y - a.y) == (point.y - a.y) * (b.x - a.x) and
                (point.x - a.x) * (point.x - b.x) + (point.y - a.y) * (point.y - b.y) <= 0.0)
                return true;
            j += 1;
        }
        i += 1;
    }
    return false;
}

fun beamEndpoint(bridge: ref Bridge, terrain: ref List[List[Vec2]], start: i64,
                 snapped: Vec2, mouse: Vec2) -> Vec2 = {
    let a = bridge.joints.pointer[start].position;
    let dx = snapped.x - a.x;
    let dy = snapped.y - a.y;
    if (dx * dx + dy * dy <= maxBeamLength * maxBeamLength) return snapped;

    var best = a;
    var nearest = -1.0f32;
    var row = -maxBeamCells;
    while (row <= maxBeamCells) {
        var col = -maxBeamCells;
        while (col <= maxBeamCells) {
            let point = Vec2(a.x + (col as f32) * gridStep, a.y + (row as f32) * gridStep);
            let x = point.x - mouse.x;
            let y = point.y - mouse.y;
            let distance = x * x + y * y;
            if ((nearest < 0.0 or distance < nearest) and canPlaceBeam(bridge, terrain, start, point) and
                (not onBankEdge(point, terrain) or jointAt(&bridge.joints, point) >= 0)) {
                nearest = distance;
                best = point;
            }
            col += 1;
        }
        row += 1;
    }
    return best;
}

fun jointAt(joints: ref List[Joint], point: Vec2) -> i64 = {
    var i = 0;
    while (i < joints.length()) {
        let p = joints.pointer[i].position;
        if (p.x == point.x and p.y == point.y) return i;
        i += 1;
    }
    return -1;
}

fun removeUnusedJoint(bridge: ref mut Bridge, index: i64) = {
    if (bridge.joints.pointer[index].fixed) return;
    var i = 0;
    while (i < bridge.planks.length()) {
        let plank = bridge.planks.pointer[i];
        if (plank.a == index or plank.b == index) return;
        i += 1;
    }
    let last = bridge.joints.pop();
    let moved = bridge.joints.length();
    if (index == moved) return;
    bridge.joints.pointer[index] = last;
    i = 0;
    while (i < bridge.planks.length()) {
        let plank = &bridge.planks.pointer[i];
        if (plank.a == moved) plank.a = index;
        if (plank.b == moved) plank.b = index;
        i += 1;
    }
}

fun beamAtMouse(bridge: ref Bridge, mouse: Vec2, zoom: f32) -> i64 = {
    let point = b2.b2Vec2(mouse.x, mouse.y);
    let radius = plankThickness / 2.0 + 10.0 / zoom;
    var nearest = radius * radius;
    var index = -1;
    var i = 0;
    while (i < bridge.planks.length()) {
        let plank = bridge.planks.pointer[i];
        if (not plank.road) {
            let a = bridge.joints.pointer[plank.a].position;
            let b = bridge.joints.pointer[plank.b].position;
            let hit = b2.b2SegmentDistance(b2.b2Vec2(a.x, a.y), b2.b2Vec2(b.x, b.y), point, point);
            if (hit.distanceSquared <= nearest) {
                nearest = hit.distanceSquared;
                index = i;
            }
        }
        i += 1;
    }
    return index;
}

fun deleteBeam(bridge: ref mut Bridge, index: i64) = {
    let removed = bridge.planks.pointer[index];
    let last = bridge.planks.pop();
    if (index < bridge.planks.length()) bridge.planks.pointer[index] = last;
    removeUnusedJoint(bridge, math.max(removed.a, removed.b));
    removeUnusedJoint(bridge, math.min(removed.a, removed.b));
}

class BeamTarget {
    point: Vec2;
    joint: i64;
    beam: i64;
    valid: bool;
}

fun beamTarget(bridge: ref Bridge, terrain: ref List[List[Vec2]], start: i64,
               snapped: Vec2, mouse: Vec2, zoom: f32) -> BeamTarget = {
    if (start < 0) {
        let joint = jointAt(&bridge.joints, snapped);
        return BeamTarget(snapped, joint, beamAtMouse(bridge, mouse, zoom), joint >= 0);
    }
    let end = beamEndpoint(bridge, terrain, start, snapped, mouse);
    return BeamTarget(end, jointAt(&bridge.joints, end), -1, canPlaceBeam(bridge, terrain, start, end));
}

fun editBridge(bridge: ref mut Bridge, start: ref mut i64, target: ref BeamTarget, rightClick: bool) = {
    if (rightClick) {
        if (start < 0 and target.beam >= 0) deleteBeam(bridge, target.beam);
        start = -1;
        return;
    }
    if (start < 0) {
        start = target.joint;
        return;
    }

    let first: i64 = start;
    start = -1;
    if (not target.valid) return;
    var end = target.joint;
    if (end < 0) {
        end = bridge.joints.length();
        bridge.joints.push(Joint(target.point, fixed=false));
    }
    bridge.planks.push(PlankDef(first, end, road=false));
}

fun drawGrid(camera: ref rl.Camera2D) = {
    let color = rl.Color(40u8, 40u8, 40u8, 255u8);
    let viewport = rl.Vector2(rl.GetScreenWidth() as f32,
                              rl.GetScreenHeight() as f32);
    let lo = rl.GetScreenToWorld2D(rl.Vector2(0.0, 0.0), camera);
    let hi = rl.GetScreenToWorld2D(viewport, camera);

    var col = (lo.x / gridStep) as i32;
    while (col <= (hi.x / gridStep) as i32) {
        let x = (col as f32) * gridStep;
        rl.DrawLineV(rl.Vector2(x, lo.y), rl.Vector2(x, hi.y), color);
        col += 1;
    }

    var row = (lo.y / gridStep) as i32;
    while (row <= (hi.y / gridStep) as i32) {
        let y = (row as f32) * gridStep;
        rl.DrawLineV(rl.Vector2(lo.x, y), rl.Vector2(hi.x, y), color);
        row += 1;
    }
}

fun drawTerrain(terrain: ref List[List[Vec2]]) = {
    var i = 0;
    while (i < terrain.length()) {
        let bank = &terrain.pointer[i];
        let a = bank.pointer[0];
        var j = 1;
        while (j + 1 < bank.length()) {
            let b = bank.pointer[j];
            let c = bank.pointer[j + 1];
            rl.DrawTriangle(Vec2(a.x, -a.y), Vec2(b.x, -b.y), Vec2(c.x, -c.y),
                            rl.DARKGREEN);
            j += 1;
        }
        i += 1;
    }
}

fun drawPlank(a: Vec2, b: Vec2, color: rl.Color) = {
    rl.DrawLineEx(Vec2(a.x, -a.y), Vec2(b.x, -b.y), plankThickness, color);
}

fun drawJoint(p: Vec2, fixed: bool) = {
    let color = if fixed then rl.WHITE else rl.GRAY;
    rl.DrawCircleV(Vec2(p.x, -p.y), gridStep / 5.0, color);
}

fun drawBridge(bridge: ref Bridge, hovered: i64) = {
    for (road in [false, true]) {
        var i = 0;
        while (i < bridge.planks.length()) {
            let plank = bridge.planks.pointer[i];
            if (plank.road == road) {
                let color = if road then rl.WHITE else (if i == hovered then rl.RED else rl.DARKGRAY);
                drawPlank(bridge.joints.pointer[plank.a].position,
                          bridge.joints.pointer[plank.b].position, color);
            }
            i += 1;
        }
    }
    var j = 0;
    while (j < bridge.joints.length()) {
        let joint = bridge.joints.pointer[j];
        drawJoint(joint.position, joint.fixed);
        j += 1;
    }
}

fun drawSimulatedBridge(bridge: ref Bridge, planks: ref List[Plank]) = {
    for (road in [false, true]) {
        var i = 0;
        while (i < bridge.planks.length()) {
            if (bridge.planks.pointer[i].road == road) {
                let plank = planks.pointer[i];
                let a = b2.b2Body_GetWorldPoint(plank.body, b2.b2Vec2(-plank.halfLength, 0.0));
                let b = b2.b2Body_GetWorldPoint(plank.body, b2.b2Vec2(plank.halfLength, 0.0));
                drawPlank(Vec2(a.x, a.y), Vec2(b.x, b.y), if road then rl.WHITE else rl.DARKGRAY);
            }
            i += 1;
        }
    }
    var j = 0;
    while (j < bridge.joints.length()) {
        let joint = bridge.joints.pointer[j];
        if (joint.fixed) drawJoint(joint.position, fixed=true);
        j += 1;
    }
}

fun drawCursor(point: Vec2) = {
    let x = point.x;
    let y = -point.y;
    let gap = gridStep * 0.25;
    let arm = gridStep * 0.5;

    rl.DrawLineV(Vec2(x - arm, y), Vec2(x - gap, y), rl.GREEN);
    rl.DrawLineV(Vec2(x + gap, y), Vec2(x + arm, y), rl.GREEN);
    rl.DrawLineV(Vec2(x, y - arm), Vec2(x, y - gap), rl.GREEN);
    rl.DrawLineV(Vec2(x, y + gap), Vec2(x, y + arm), rl.GREEN);
}

fun drawDuck(texture: rl.Texture2D, feet: Vec2, mass: f32) = {
    let w = texture.width as f32;
    let h = texture.height as f32;
    let height = duckHeight(mass);
    let width = height * w / h;
    rl.DrawTexturePro(texture, rl.Rectangle(0.0, 0.0, w, h),
                      rl.Rectangle(feet.x - width / 2.0, -feet.y - height, width, height),
                      Vec2(0.0, 0.0), 0.0, rl.WHITE);
}

const fontSize: i32 = 20;

fun drawFps() = {
    rl.DrawText(f"{rl.GetFPS()}", posX=4, posY=4, fontSize=fontSize, color=rl.DARKGRAY);
}

fun drawCoords(col: i32, row: i32) = {
    rl.DrawText(f"{col}, {row}", 4, rl.GetScreenHeight() - fontSize - 4, fontSize, rl.WHITE);
}

fun drawMode(editing: bool) = {
    let mode = if editing then "Edit" else "Test";
    let x = (rl.GetScreenWidth() - rl.MeasureText(mode, fontSize)) / 2;
    rl.DrawText(mode, x, rl.GetScreenHeight() - fontSize - 4, fontSize, rl.WHITE);
}

fun drawBudget(beams: i64) = {
    let amount = f"{beams * 100}";
    let text = amount.asSlice();
    let x = rl.GetScreenWidth() - rl.MeasureText(text, fontSize) - 4;
    let y = rl.GetScreenHeight() - fontSize - 4;
    let pixel = fontSize / 10;
    let euroX = x - rl.MeasureText("C", fontSize) - pixel;
    rl.DrawText("C", euroX, y, fontSize, rl.WHITE);
    rl.DrawRectangle(euroX - pixel, y + 4 * pixel, 5 * pixel, pixel, rl.WHITE);
    rl.DrawRectangle(euroX - pixel, y + 6 * pixel, 5 * pixel, pixel, rl.WHITE);
    rl.DrawText(text, x, y, fontSize, rl.WHITE);
}

fun main() = {
    rl.InitWindow(800, 600, "QuackPlank");
    if (not rl.IsWindowReady())
        panicking.panic();

    let duck = rl.LoadTexture("src/duck.png");
    if (not rl.IsTextureValid(duck))
        panicking.panic();
    rl.SetTextureFilter(duck, rl.TEXTURE_FILTER_BILINEAR);

    let level = level1();
    var bridge = initialBridge(&level);
    const initialZoom = 40.0;
    var camera = rl.Camera2D(
        offset=rl.Vector2(rl.GetScreenWidth() as f32 / 2.0,
                          rl.GetScreenHeight() as f32 / 2.0),
        target=rl.Vector2(0.0, 0.0),
        rotation=0.0,
        zoom=initialZoom * 2.0,
    );

    var world: b2.b2WorldId;
    var roadAnchors: List[RoadAnchor];
    var duckMass = 35.0f32;
    var duckShape: b2.b2ShapeId;
    var pins: List[List[Attachment]];
    var planks: List[Plank];
    var elapsed = 0.0;
    var editing = true;
    var beamStart: i64 = -1;
    while (not rl.WindowShouldClose()) {
        if (rl.IsKeyPressed(rl.KEY_SPACE)) {
            beamStart = -1;
            editing = not editing;
            if (editing) {
                b2.b2DestroyWorld(world);
                pins.clear();
                planks.clear();
            } else {
                let def = b2.b2DefaultWorldDef();
                world = b2.b2CreateWorld(&def);
                var banks: List[b2ShapeId];
                let ground = createTerrain(world, &level.terrain, &banks);
                createBridge(world, ground, &bridge, &pins, &planks);
                roadAnchors = findRoadAnchors(&bridge, &planks, &banks);
                registerPreSolve(world, &roadAnchors as cptr u8);
                duckShape = createDuck(world, level.start, duckMass);
                elapsed = 0.0;
            }
        }

        if (not editing) {
            const tick = 1.0f32 / 60.0;
            elapsed += rl.GetFrameTime();
            while (elapsed >= tick) {
                b2.b2World_Step(world, tick, 4);
                breakOverloadedPlanks(world, &pins, &planks);
                elapsed -= tick;
            }
        }

        if (updateDuckMass(&duckMass) and not editing) resizeDuck(duckShape, duckMass);
        updateCamera(&camera, initialZoom);
        let mouse = mousePosition(&camera);
        let point = GridPoint(gridIndex(mouse.x), gridIndex(mouse.y));

        var target: BeamTarget;
        if (editing) {
            let snapped = gridPosition(point);
            target = beamTarget(&bridge, &level.terrain, beamStart, snapped, mouse, camera.zoom);
            let rightClick = rl.IsMouseButtonPressed(rl.MOUSE_BUTTON_RIGHT);
            if (rightClick or rl.IsMouseButtonPressed(rl.MOUSE_BUTTON_LEFT)) {
                editBridge(&bridge, &beamStart, &target, rightClick);
                target = beamTarget(&bridge, &level.terrain, beamStart, snapped, mouse, camera.zoom);
            }
        }

        rl.BeginDrawing();
        rl.ClearBackground(rl.BLACK);
        rl.BeginMode2D(camera);
        if (editing) drawGrid(&camera);
        drawTerrain(&level.terrain);
        if (editing) {
            drawBridge(&bridge, target.beam);
            if (beamStart >= 0 and target.valid)
                drawPlank(bridge.joints.pointer[beamStart].position, target.point, rl.GRAY);
            if (target.valid) drawCursor(target.point);
        } else {
            drawSimulatedBridge(&bridge, &planks);
        }
        let feet = if editing then level.start else bodyPosition(b2.b2Shape_GetBody(duckShape));
        drawDuck(duck, feet, duckMass);
        rl.EndMode2D();

        drawFps();
        drawCoords(point.col, point.row);
        drawMode(editing);
        let roadSegments = math.max(0, level.road.length() - 1);
        drawBudget(bridge.planks.length() - roadSegments);
        rl.EndDrawing();
    }
    if (not editing) b2.b2DestroyWorld(world);

    rl.UnloadTexture(duck);
    rl.CloseWindow();
    return 0;
}
